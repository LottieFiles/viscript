{
  "name": "@viscript/obsidian",
  "version": "0.1.0",
  "description": "Obsidian plugin that plays viscript scenes in notes, rendered by the WASM runtime in a worker.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "check": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "test:obsidian": "node esbuild.config.mjs && node --test test/obsidian/run.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3"
  }
}
