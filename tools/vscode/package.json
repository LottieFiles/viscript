{
  "name": "vis-preview",
  "displayName": "viscript Preview",
  "description": "Live canvas previews for viscript Lua scenes in Visual Studio Code.",
  "version": "0.7.80",
  "publisher": "viscript",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "viscript",
    "lua",
    "animation",
    "canvas",
    "thorvg"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:lua",
    "onLanguage:c",
    "onLanguage:cpp",
    "workspaceContains:.vscode/vis/visualizations.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "visPreview.openViewer",
        "title": "viscript: Open Viewer"
      },
      {
        "command": "visPreview.openToSide",
        "title": "viscript: Open Preview to the Side",
        "icon": {
          "light": "media/icon.svg",
          "dark": "media/icon.svg"
        }
      },
      {
        "command": "visPreview.refresh",
        "title": "viscript: Refresh Preview"
      },
      {
        "command": "visPreview.openRuntimeFolder",
        "title": "viscript: Open Bundled Runtime Folder"
      },
      {
        "command": "visPreview.enableLuaLs",
        "title": "viscript: Enable LuaLS Type Definitions"
      },
      {
        "command": "visPreview.savePng",
        "title": "viscript: Save Current Viewer as PNG",
        "enablement": "visPreview.hasPreview"
      },
      {
        "command": "visPreview.saveGif",
        "title": "viscript: Save Current Viewer as GIF",
        "enablement": "visPreview.hasPreview"
      },
      {
        "command": "visPreview.saveMp4",
        "title": "viscript: Save Current Viewer as MP4",
        "enablement": "visPreview.hasPreview"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "visPreview.openToSide",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "visPreview.openToSide",
          "when": "editorLangId == lua && visPreview.isScene",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "viscript Preview",
      "properties": {
        "visPreview.updateDelay": {
          "type": "number",
          "default": 280,
          "minimum": 100,
          "maximum": 2000,
          "description": "Milliseconds to wait after a Lua edit before refreshing the preview."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".vscode/vis/visualizations.json",
        "url": "./schemas/visualizations.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "node scripts/generate-lua-meta.mjs && tsc -p . && node esbuild.mjs",
    "watch": "tsc -watch -p .",
    "check": "tsc --noEmit -p .",
    "test": "npm run compile && node --test test/*.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "gifenc": "1.0.3",
    "mediabunny": "1.55.1",
    "shiki": "4.4.3",
    "typescript": "^5.7.2"
  }
}
